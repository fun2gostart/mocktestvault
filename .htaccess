# LiteSpeed & Apache Configuration for MockTestVault
DirectoryIndex index.html

<IfModule LiteSpeed>
    CacheEngine off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Clean subdirectories trailing slash
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # Auto-heal any malformed nested relative /data/ requests to canonical root /data/
    RewriteRule ^.+/(data/.*)$ /$1 [R=301,L]

    # Auto-heal any malformed /undefined requests to their parent directory
    RewriteRule ^(.+/)?undefined/?$ /$1 [R=301,L]

    # 301 Redirect legacy/stub chapter URL to canonical silo structure
    RewriteRule ^cbse-class-10-science-chapter-2\.html$ /cbse-class-10/science/ch02_acids_bases_salts.html [R=301,L]

    # Block direct web access to internal scripts directory
    RewriteRule ^scripts(/.*)?$ - [F,L]
</IfModule>

# Security: Deny direct access to internal development scripts, pyc, and documentation
<FilesMatch "\.(py|pyc|md|sh|log|bak|sql)$">
    Require all denied
</FilesMatch>


# Protect internal audit / release artefacts shipped in development ZIPs.
# Keep only the five registers intentionally linked from question-sources-review.html public.
<FilesMatch "^(?!QUESTION_ANSWER_VERIFICATION_REGISTER_v2\.9\.csv$|PYQ_AUTHENTICATION_REGISTER_v2\.9\.csv$|QUESTION_REVIEW_BACKLOG_BY_FILE_v2\.9\.csv$|QUESTION_DUPLICATE_REVIEW_REGISTER_v2\.9\.csv$|QUESTION_EXPLANATION_VARIANCE_REGISTER_v2\.9\.csv$).+\.csv$">
    Require all denied
</FilesMatch>

# Keep public discovery/verification text endpoints available; deny internal release notes and QA reports.
<FilesMatch "^(?!robots\.txt$|ads\.txt$|llms\.txt$|llms-full\.txt$|d2593d2bc318fe4903957431a33b15d1\.txt$).+\.txt$">
    Require all denied
</FilesMatch>

# Hide repository helper files from direct requests.
<FilesMatch "^(\.gitignore|\.nojekyll)$">
    Require all denied
</FilesMatch>

# Browser Caching & Performance
<IfModule mod_headers.c>
    # HTML pages must revalidate so updated study content and test configuration are not stuck in browser cache.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Versioned-by-release static resources: short browser cache with revalidation.
    # The service-worker cache name is also bumped in each release.
    <FilesMatch "\.(css|js|json)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Static images, icons and fonts change infrequently but filenames are not content-hashed.
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    # Search and discovery files should refresh daily/hourly rather than be held indefinitely.
    <FilesMatch "^(sitemap\.xml|feed\.xml|robots\.txt|llms\.txt|llms-full\.txt)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Never cache Service Worker (critical for PWA updates)
    <FilesMatch "^(sw\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>

    # Correct Web Manifest MIME
    <FilesMatch "\.(webmanifest|json)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Apple App Site Association MIME
    <Files "apple-app-site-association">
        ForceType application/json
        Header set Access-Control-Allow-Origin "*"
    </Files>

    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 1 week"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 week"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
